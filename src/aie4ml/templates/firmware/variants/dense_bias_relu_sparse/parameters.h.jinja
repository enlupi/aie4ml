{% set P = L.op_impl.parameters %}
struct {{L.struct_name}} {
  using data_t = {{P.precision.lhs.c_type}};
  using weight_t = {{P.precision.rhs.c_type}};
  using result_t = {{P.precision.output.c_type}};
  using bias_t = {{P.precision.bias.c_type}};
  static constexpr int IN_FEAT = {{L.n_in}}; static constexpr int OUT_FEAT = {{L.n_out}};
  static constexpr int CAS_LENGTH = {{P.parallelism.cas_length}}; static constexpr int CAS_NUM = {{P.parallelism.cas_num}};
  static constexpr bool PARALLELISM_CONTRACT_OUTER = {{ 'true' if P.parallelism.contract == 'outer' else 'false' }};
  static constexpr bool USE_BIAS = {{ 'true' if P.flags.use_bias else 'false' }};
  static constexpr bool USE_RELU = {{ 'true' if P.flags.use_relu else 'false' }};
  static constexpr bool TRANSPOSE_INPUT = {{ 'true' if P.flags.transpose_lhs else 'false' }};
  static constexpr int SHIFT = {{P.shift}};
  // Sparse-capable aie::mmul microtile (see SPARSE_MICROTILE_OPTIONS). The matching L1-input DMA
  // tiling is emitted from this same microtile by the staging descriptors, so the kernel and the
  // DMA cannot drift apart.
  static constexpr int M = {{P.microtiling.microtile_m}}, K = {{P.microtiling.microtile_k}}, N = {{P.microtiling.microtile_n}};
  static constexpr int col_placement = {{L.placement.col}};
  static constexpr int row_placement = {{L.placement.row}};
  static constexpr int padded_independent_extent = {{P.full_outer}};
  static constexpr int padded_IN_FEAT = {{P.full_inner_lhs}};
  static constexpr int padded_OUT_FEAT = {{P.full_inner_rhs}};
  static constexpr int IN_FEAT_SLICE = {{P.tile_inner_lhs}};
  static constexpr int OUT_FEAT_SLICE = {{P.tile_inner_rhs}};
  static constexpr int RAW_IN_FEAT_SLICE = {{P.tile_inner_lhs_raw}};
  static constexpr int RAW_OUT_FEAT_SLICE = {{P.tile_inner_rhs_raw}};
  // AIE-ML hardware sparse matrix multiplication for the weight (B) matrix, via
  // aie::sparse_vector / aie::sparse_vector_input_buffer_stream and the sparse
  // aie::mmul::mac/mul(VecA, SparseVectorOrOp) overload. The ROM was compressed by
  // pack_mmul_rhs_sparse_matrix: 2:4 structured along the reduction axis, column-major within
  // each microtile.
  static constexpr bool USE_SPARSE = true;
  // Compressed bytes per (K, N) microtile == aie::sparse_vector<weight_t, K*N>::memory_bytes():
  // the kept values (K*N / 2) plus a one-bit-per-byte mask (K*N / 8). Constant because the
  // packer keeps exactly 2 of every 4 values, which is what makes it usable as the kernel's
  // compile-time tile stride through the ROM.
  static constexpr int SPARSE_TILE_BYTES = {{P.sparse_tile_bytes}};
  static constexpr int WTS_ELEMS = {{P.wts_elems}};
  using acc_scalar_t = {{ P.accumulator_tag }};
  static constexpr const char* ROUNDING_TOKEN = "{{ P.rounding_mode }}";
  static constexpr const char* SATURATION_TOKEN = "saturate";
#if __cplusplus >= 202002L
  static constexpr auto ROUNDING   = aie::rounding_mode::{{ P.rounding_mode }};
  static constexpr auto SATURATION = aie::saturation_mode::saturate;
#endif
};
